---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const selectedCategoryIds = Astro.url.searchParams
    .getAll('category')
    .map(Number)
    .filter((id) => Number.isInteger(id) && id > 0);
const selectedPublisherIds = Astro.url.searchParams
    .getAll('publisher')
    .map(Number)
    .filter((id) => Number.isInteger(id) && id > 0);
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase(), {
    categoryIds: selectedCategoryIds.length > 0 ? selectedCategoryIds : undefined,
    publisherIds: selectedPublisherIds.length > 0 ? selectedPublisherIds : undefined,
});
const hasActiveFilters = selectedCategoryIds.length > 0 || selectedPublisherIds.length > 0;
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/80 p-4 shadow-lg" data-testid="games-filter-panel">
      <form method="get" action="/" class="space-y-4" data-testid="games-filter-form">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <fieldset class="flex-1" data-testid="category-filter-group">
            <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label
                  class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-900/50 px-3 py-2 text-sm text-slate-200 transition-colors duration-200 hover:border-blue-500 hover:text-blue-300 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
                  data-testid={`category-filter-option-${category.id}`}
                >
                  <input
                    type="checkbox"
                    name="category"
                    value={String(category.id)}
                    checked={selectedCategoryIds.includes(category.id)}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid={`filter-category-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="flex-1" data-testid="publisher-filter-group">
            <legend class="mb-2 text-sm font-medium text-slate-200">Publishers</legend>
            <div class="flex flex-wrap gap-2">
              {publishers.map((publisher) => (
                <label
                  class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-900/50 px-3 py-2 text-sm text-slate-200 transition-colors duration-200 hover:border-purple-500 hover:text-purple-300 focus-within:ring-2 focus-within:ring-purple-500 focus-within:outline-none"
                  data-testid={`publisher-filter-option-${publisher.id}`}
                >
                  <input
                    type="checkbox"
                    name="publisher"
                    value={String(publisher.id)}
                    checked={selectedPublisherIds.includes(publisher.id)}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-purple-500 focus:ring-2 focus:ring-purple-500 focus:outline-none"
                    data-testid={`filter-publisher-${publisher.id}`}
                  />
                  <span>{publisher.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="flex items-center gap-3">
            <button
              type="submit"
              class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white shadow-sm transition-colors duration-200 hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="apply-filters-button"
            >
              Apply filters
            </button>
            <a
              href="/"
              class:list={['text-sm text-blue-400 underline-offset-2 hover:text-blue-300 hover:underline focus:ring-2 focus:ring-blue-500 focus:outline-none', { hidden: !hasActiveFilters }]}
              data-testid="clear-filters-link"
            >
              Clear filters
            </a>
          </div>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <div
        class="mb-6 rounded-xl border border-slate-700 bg-slate-800/80 p-6 text-slate-200"
        data-testid="games-empty-state"
        hidden={games.length > 0 && !hasActiveFilters}
      >
        <p>{hasActiveFilters ? 'No games match your current filters.' : 'No games available at the moment.'}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid" hidden={games.length === 0 && !hasActiveFilters}>
        {games.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </div>
</Layout>

<script>
  const syncFilterState = () => {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(
      params
        .getAll('category')
        .map((value) => Number(value))
        .filter((value) => Number.isInteger(value) && value > 0),
    );
    const selectedPublishers = new Set(
      params
        .getAll('publisher')
        .map((value) => Number(value))
        .filter((value) => Number.isInteger(value) && value > 0),
    );

    document.querySelectorAll<HTMLInputElement>('input[type="checkbox"][name="category"]').forEach((input) => {
      input.checked = selectedCategories.has(Number(input.value));
    });
    document.querySelectorAll<HTMLInputElement>('input[type="checkbox"][name="publisher"]').forEach((input) => {
      input.checked = selectedPublishers.has(Number(input.value));
    });

    const clearFiltersLink = document.querySelector<HTMLElement>('[data-testid="clear-filters-link"]');
    const hasActiveFilters = selectedCategories.size > 0 || selectedPublishers.size > 0;
    if (clearFiltersLink) {
      clearFiltersLink.classList.toggle('hidden', !hasActiveFilters);
      clearFiltersLink.hidden = !hasActiveFilters;
    }

    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="games-empty-state"]');

    cards.forEach((card) => {
      const categoryId = Number(card.getAttribute('data-game-category-id'));
      const publisherId = Number(card.getAttribute('data-game-publisher-id'));
      const matchesCategories = selectedCategories.size === 0 || selectedCategories.has(categoryId);
      const matchesPublishers = selectedPublishers.size === 0 || selectedPublishers.has(publisherId);
      const isVisible = matchesCategories && matchesPublishers;
      card.hidden = !isVisible;
    });

    const visibleCards = cards.filter((card) => !card.hidden);
    if (gamesGrid) {
      gamesGrid.hidden = hasActiveFilters && visibleCards.length === 0;
    }

    if (emptyState) {
      const noMatches = hasActiveFilters && visibleCards.length === 0;
      emptyState.hidden = !noMatches;
      const message = emptyState.querySelector('p');
      if (message && hasActiveFilters) {
        message.textContent = 'No games match your current filters.';
      }
    }
  };

  document.addEventListener('DOMContentLoaded', syncFilterState);
  window.addEventListener('pageshow', syncFilterState);
</script>
